    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "nanoid": "^3.3.18",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.11.10",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12"
  }
